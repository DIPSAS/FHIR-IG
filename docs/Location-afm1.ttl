     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Location afm1</b></p><a name=\"afm1\"> </a><a name=\"hcafm1\"> </a></div>"
  ] .

