       fhir:Element.id [ fhir:value "Encounter.location.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.location.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "DIPS: active | reserved | completed (see the definition for details)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Bed/ward for out patients and planned encounters:\r\n- 'active' is always returned\r\n\r\nBed/ward for admitted patients:\r\n- 'active' for the current or last stay (\"postopphold\"), also when the encounter is finished.\r\n- 'reserved' for the parent stay when the patient is at a technical ward\r\n- 'completed' for old ward stays if the patient has many stays" ] ;
       fhir:ElementDefinition.comment [ fhir:value "When the patient is no longer active at a location, then the period end date is entered, and the status may be changed to completed." ] ;
